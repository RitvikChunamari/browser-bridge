{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser Bridge",
  "version": "0.4.0-beta.1",
  "identifier": "local.browserbridge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Browser Bridge",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Local browser migration with verified backups",
    "longDescription": "Move portable browser data with local backups, explicit permissions, observed verification and recovery. Unverified routes remain guided.",
    "resources": {
      "resources/Connector/": "Connector/",
      "resources/Importer/": "Importer/",
      "resources/ThirdPartyNotices.html": "ThirdPartyNotices.html"
    },
    "externalBin": [
      "binaries/bridge-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
