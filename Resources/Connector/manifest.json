{
  "manifest_version": 3,
  "name": "Browser Bridge Connector",
  "version": "0.3.0",
  "description": "Connect this specific browser profile to the local Browser Bridge app.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "bookmarks",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "history",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  }
}
