{
  "manifest_version": 3,
  "name": "Browser Bridge Connector",
  "version": "0.4.0",
  "description": "Connect this specific browser profile to the local Browser Bridge app.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "bookmarks",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "history",
    "tabGroups",
    "cookies"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "connector@browser-bridge.local",
      "strict_min_version": "128.0"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
